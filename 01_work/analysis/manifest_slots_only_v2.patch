+def active_slots() -> dict[str, tuple[int, ...]]:
+    """Return only slots explicitly assigned by the insertion manifest."""
+    by_file: dict[str, set[int]] = defaultdict(set)
+    with INSERTION_MANIFEST.open(encoding="utf-8-sig", newline="") as handle:
+        for row in csv.DictReader(handle):
+            if row["mode"] != "e2":
+                continue
+            name, slot = row["file"], int(row["slot"])
+            if slot in by_file[name]:
+                raise ValueError(f"duplicate assigned slot: {name}:{slot}")
+            by_file[name].add(slot)
+    return {name: tuple(sorted(slots)) for name, slots in by_file.items()}
+
