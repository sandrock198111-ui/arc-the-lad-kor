[{"file": "C2/SC0B6.DAT", "offset": "0x472B4", "ko": "120회째 승리를 기념하여 선물이 있습니다. 다음 상품 중에서 골라 주십시오."}, {"file": "C2/SC0B6.DAT", "offset": "0x4731A", "ko": "|디르의 어금니"}, {"file": "C2/SC0B6.DAT", "offset": "0x47360", "ko": "디르의 어금니를 손에 넣었다."}, {"file": "C2/SC0B6.DAT", "offset": "0x47446", "ko": "160회째 승리를 기념하여 선물이 있습니다. 다음 상품 중에서 골라 주십시오."}, {"file": "C2/SC0B6.DAT", "offset": "0x474B2", "ko": "|파워 리스트|하이퍼 부츠|치유의 부적|조개껍데기"}, {"file": "C2/SC0B6.DAT", "offset": "0x477D2", "ko": "200회째 승리를 기념하여 선물이 있습니다. 다음 상품 중에서 골라 주십시오."}, {"file": "C2/SC0B6.DAT", "offset": "0x47838", "ko": "|환상의 건틀릿"}, {"file": "C2/SC0B6.DAT", "offset": "0x47960", "ko": "1000회째 승리를 기념하여 선물이 있습니다. 다음 상품 중에서 골라 주십시오."}, {"file": "C2/SC0B6.DAT", "offset": "0x479C6", "ko": "|투기장 창고의 내용물"}, {"file": "C2/SC0B6.DAT", "offset": "0x47FD6", "ko": "바이올렛 레이서를 손에 넣었다."}, {"file": "C2/SC0B6.DAT", "offset": "0x48020", "ko": "일각수의 뿔을 손에 넣었다."}, {"file": "C2/SC0B6.DAT", "offset": "0x48064", "ko": "이제 상품은 없습니다만 힘내 주십시오."}, {"file": "C2/SC0C1.DAT", "offset": "0x489BC", "ko": "오오, 이런 곳에 순수한 헤모지가 있구먼."}, {"file": "C2/SC0C1.DAT", "offset": "0x48A18", "ko": "...그렇지, 당장 조사해야겠구먼."}, {"file": "C2/SC0C1.DAT", "offset": "0x48A90", "ko": "어라..."}, {"file": "C2/SC0C1.DAT", "offset": "0x48AEC", "ko": "오오, 이런, 나까지 헤모지가 되어 버렸구먼."}, {"file": "C2/SC0C1.DAT", "offset": "0x48B40", "ko": "일단 내 수집품에 더해 두겠네"}, {"file": "C2/SC0C1.DAT", "offset": "0x48B88", "ko": "벌었다, 벌었어. 우히햐햐"}, {"file": "C2/SC0C1.DAT", "offset": "0x48BDE", "ko": "소환수 헤모지를 손에 넣었습니다"}, {"file": "D/SD014.DAT", "offset": "0x47A8E", "ko": "틀림없구먼."}, {"file": "D/SD015.DAT", "offset": "0x47A5E", "ko": "우리도 가겠네."}, {"file": "D/SD015.DAT", "offset": "0x47B44", "ko": "자, 나도 가 볼까."}, {"file": "D/SD021.DAT", "offset": "0x47B8E", "ko": "제법 그럴듯한 소리를 하게 됐구먼."}, {"file": "D/SD021.DAT", "offset": "0x47BDE", "ko": "후훗후훗후훗."}, {"file": "D/SD031.DAT", "offset": "0x45924", "ko": "겉보기와 달리 강하구먼, 너희들."}, {"file": "D/SD031.DAT", "offset": "0x4596E", "ko": "아까 그 몬스터에게 붙잡혀 있던 할아버지다."}, {"file": "D/SD031.DAT", "offset": "0x45AAA", "ko": "너희들, 옛 전기를 읽고 온 것이겠지."}, {"file": "D/SD031.DAT", "offset": "0x45BEA", "ko": "자, 다시 묻겠는데 성궤의 힘을 손에 넣으려면 어떻게 해야 하지?"}, {"file": "D/SD031.DAT", "offset": "0x45CA4", "ko": "우선 이 세계를 이루는 5대 정령을 구해야 하네."}, {"file": "D/SD031.DAT", "offset": "0x45D2E", "ko": "그렇지. 이 세계를 만들고 움직이는 모든 정령들의 대표"}, {"file": "D/SD031.DAT", "offset": "0x45D88", "ko": "그것이 땅, 물, 불, 바람, 빛의 5요소를 관장하는 정령이니라."}, {"file": "D/SD031.DAT", "offset": "0x45F3C", "ko": "이끈 것...? 아버지가 보낸 편지구나!"}, {"file": "D/SD031.DAT", "offset": "0x45F8E", "ko": "그건 어디서 온 것이려나?"}, {"file": "D/SD031.DAT", "offset": "0x460E2", "ko": "이야기는 정해진 모양이구먼. 그럼 가 볼까."}, {"file": "D/SD031.DAT", "offset": "0x463DA", "ko": "어라? 이 돌은 뭐였더라..."}, {"file": "D/SD031.DAT", "offset": "0x463FC", "ko": "로맨싱 스톤을 가지고 있었다!"}, {"file": "D/SD031.DAT", "offset": "0x46564", "ko": "이제부터 음성이 잘 들리지 않게 되니 볼륨을 조금 올려 줘"}, {"file": "D/SD031.DAT", "offset": "0x465EE", "ko": "굉장한 아이템을 손에 넣었다!"}, {"file": "D/SD031.DAT", "offset": "0x4672A", "ko": "촌가라의 굉장한 아이템을 빼앗았다!"}, {"file": "D/SD031.DAT", "offset": "0x467FC", "ko": "굉장한 아이템을 되찾았다!"}, {"file": "D/SD031.DAT", "offset": "0x4699E", "ko": "굉장한 아이템을 빼앗아 들었다!"}, {"file": "D/SD031.DAT", "offset": "0x46A2A", "ko": "굉장한 아이템이 부서져 날아갔다!"}, {"file": "D/SD031.DAT", "offset": "0x46A88", "ko": "부서진 아이템을 알아차리지 못했다."}, {"file": "D/SD071.DAT", "offset": "0x486B4", "ko": "어서 성궤가 있는 곳으로 가야 하는데..."}, {"file": "D/SD071.DAT", "offset": "0x48782", "ko": "와 줬다고. 약속대로 말이야!"}, {"file": "D/SD071.DAT", "offset": "0x488AA", "ko": "어서 산을 내려가자. 성궤는 사르바시오 폭포다!"}, {"file": "E5/SE05A.DAT", "offset": "0x48734", "ko": "후후후, 용케 여기까지 왔구나."}, {"file": "E5/SE05A.DAT", "offset": "0x48750", "ko": "하지만! 과연 이 나를 쓰러뜨릴 수 있을까"}, {"file": "E5/SE05A.DAT", "offset": "0x48772", "ko": "후후후후... 하고, 아무도 없잖아!?"}, {"file": "E5/SE05A.DAT", "offset": "0x487B6", "ko": "이쪽 이쪽, 뒤에 있어!"}, {"file": "E5/SE05A.DAT", "offset": "0x487E0", "ko": "어, 뒤 라 고"}, {"file": "E5/SE05A.DAT", "offset": "0x487F2", "ko": "어쩜 이렇게 비겁한 놈들이야! 나를 뒤에서 덮치다니!"}, {"file": "E5/SE05A.DAT", "offset": "0x4881C", "ko": "기다려, 지금 그쪽으로 가서 짓이겨 놓고 뭉개 놓고..."}, {"file": "E5/SE05A.DAT", "offset": "0x48854", "ko": "무, 거, 무 거 워"}, {"file": "E5/SE05A.DAT", "offset": "0x48874", "ko": "아 프 다 아 아 아 아 아!"}, {"file": "E5/SE05A.DAT", "offset": "0x48894", "ko": "제법인걸. 이제 용서 안 해! 에잇!"}, {"file": "E5/SE05A.DAT", "offset": "0x488C8", "ko": "역시 이쪽이 낫네!"}, {"file": "E5/SE05A.DAT", "offset": "0x488EE", "ko": "나와라, 몬스터!!"}, {"file": "E5/SE05A.DAT", "offset": "0x48922", "ko": "자, 승부야!"}, {"file": "E5/SE05A.DAT", "offset": "0x48948", "ko": "뒤라고 말하고 있는데..."}, {"file": "E5/SE05A.DAT", "offset": "0x48BF8", "ko": "아 재미있었다"}, {"file": "E5/SE05A.DAT", "offset": "0x48C08", "ko": "나, 정했어! 너희들의 친구가 되겠어!!"}, {"file": "E5/SE05A.DAT", "offset": "0x48C32", "ko": "친구라고 해도..."}, {"file": "E5/SE05A.DAT", "offset": "0x48C52", "ko": "나는 세계 제일의 대마법사 초코. 잘 부탁해."}, {"file": "E5/SE05A.DAT", "offset": "0x48C8A", "ko": "나랑 놀고 싶을 때는 촌가라 씨의 항아리로 불러 줘!"}, {"file": "E5/SE05A.DAT", "offset": "0x48CBC", "ko": "다만 수메리아의 코르보 평원, 쿠이나 언덕, 카라간 평야"}, {"file": "E5/SE05A.DAT", "offset": "0x48CEC", "ko": "밀마나의 루와지의 숲, 카카라스의 숲, 셈바라의 늪"}, {"file": "E5/SE05A.DAT", "offset": "0x48D1A", "ko": "아리바샤의 레이덴 유적, 사라 사막, 이슈마의 바위터"}, {"file": "E5/SE05A.DAT", "offset": "0x48D54", "ko": "아니면 시, 러, 어!"}, {"file": "E5/SE05A.DAT", "offset": "0x48D7A", "ko": "그럼 또 보자!!"}]