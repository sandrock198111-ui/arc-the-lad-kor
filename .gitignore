# Local/original game data. Never commit these.
00_original/
ex/
99_backup/

# Extracted work trees and packaged image workspaces are too large and may
# contain original game assets.
01_work/*
!01_work/*.csv
!01_work/analysis/

# Inside 01_work/analysis only text-based records are tracked. Screenshots,
# VRAM dumps and raw frame captures stay local; they are large and add nothing
# that the reports do not already state.
01_work/analysis/**/*.png
01_work/analysis/**/*.jpg
01_work/analysis/**/*.jpeg
01_work/analysis/**/*.bmp
01_work/analysis/**/*.pbm
01_work/analysis/**/*.bgra
01_work/analysis/**/*.raw
01_work/analysis/**/*.sav

# Scanned pages of a commercial game magazine. Never publish these.
# The extracted terminology lives in 05_docs/terminology_decisions.csv instead.
01_work/analysis/guide_scan/

# The original-font bitplane contact sheet/bitmap table is reproducible from
# the local original disc and must not be committed as extracted game art.
01_work/analysis/ascii_glyph_audit/

# Generated patch/output files. Recreate these from scripts/manifests.
03_output/
04_screenshots/

# Local third-party tools and extracted binaries.
06_tools/

# Locally saved third-party walkthrough pages and extracted scan images.
# These are scans of a commercial game magazine and must never be published.
# The extracted terminology lives in 05_docs/terminology_decisions.csv instead.
05_docs/공략/
05_docs/참고사항/

# Game/media/binary artifacts.
*.zip
*.7z
*.rar
*.bin
*.cue
*.iso
*.chd
*.dat
*.DAT
*.img
*.IMG
*.xa
*.XA
*.str
*.STR
*.exe
*.EXE
*.snd
*.SND

# Python/cache/editor noise.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# OS/editor files.
Thumbs.db
Desktop.ini
.DS_Store
.vscode/

# Local Codex desktop preferences are machine-specific.
.claude/settings.local.json

# Working backups the editors and builders leave behind. The CSV is a megabyte
# and there are a dozen copies; the history in git is the record that matters.
05_docs/*.bak

# The original disc layout XML. File names and sizes only, no game data, and
# 02_scripts/package_pristine_control.py cannot run without it.
!01_work/arc1_original_layout.xml
!01_work/arc1_v104_layout.xml

# Game executables and their backups never belong in the repository, even when
# an analysis folder is otherwise text-only.
01_work/analysis/**/*.backup
01_work/analysis/**/PSX.EXE*
01_work/analysis/**/COMM.IMG*
